# Gomr Configuration Example
# Copy this file to .env and configure it for your local or production setup.

# ==========================================
# Master Node Configuration
# ==========================================
# The port the Master node listens on for HTTP API and RPC requests.
MASTER_PORT=8080

# ==========================================
# Worker Node Configuration
# ==========================================
# The host and port where the Master node is running.
MASTER_ADDR=localhost:8080

# The port the Worker node uses to serve intermediate files via HTTP.
WORKER_PORT=8081

# ==========================================
# Storage Configuration (S3 / MinIO)
# ==========================================
# The S3-compatible endpoint URL (without http/https prefix for minio-go, unless explicitly configured).
S3_ENDPOINT=thia:3900

# AWS Credentials (used by MinIO client to authenticate with S3/Garage/MinIO)
# If using anonymous access (Secure=false and no creds required), these can be left blank.
AWS_ACCESS_KEY_ID=GK065ea61db3bb0d603a6ce9b1
AWS_SECRET_ACCESS_KEY=2f991f669f34cfb64b01a58b9f92a06e1f539c08a203e5c2a373ff0b5f1a8c95
AWS_REGION=garage
